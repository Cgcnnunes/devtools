{
  "name": "devtools",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "tools/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "lint": "eslint . && turbo run lint",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "test": "vitest run && turbo run test",
    "build": "turbo run build"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.4",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "turbo": "^2.11.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
